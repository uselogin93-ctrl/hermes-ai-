# Application
APP_URL=http://localhost:3000
APP_SESSION_SECRET=            # random string, signs the session cookie
APP_ADMIN_EMAIL=admin@careerpulse.local
APP_ADMIN_PASSWORD=careerpulse
APP_ADMIN_NAME=Operator

# Database
# Leave DATABASE_URL empty to run on the embedded Postgres (PGlite) in .data/pglite.
DATABASE_URL=                  # postgres://user:password@host:5432/careerpulse
PGLITE_PATH=.data/pglite
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server only, never expose to the client

# Encryption (AES-256-GCM for OAuth tokens at rest)
TOKEN_ENCRYPTION_KEY=          # long random string

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/connections/github/callback

# Google OAuth (Drive) and the Picker API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connections/google_drive/callback
GOOGLE_DRIVE_API_KEY=

# LinkedIn developer app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3000/api/connections/linkedin/callback

# AI providers. The router tries them in order (see src/lib/agents/providers.config.json).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
OLLAMA_BASE_URL=               # optional, enables the self-hosted fallback
OLLAMA_MODEL=llama3.1:8b

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=                      # optional, enables the email fallback
EMAIL_FROM=

# Scheduler
SYSTEM_CRON_SECRET=            # shared secret header for /api/system/run-daily-cycle

# Local development
DEMO_MODE=                     # 1 forces the deterministic offline agent provider
ALLOW_UNAUTHENTICATED_CRON=    # 1 allows the cron endpoint without a secret (local only)
NEXT_PUBLIC_APP_VERSION=1.0.0
